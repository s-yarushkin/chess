# Copy to .env (mode 600), never commit actual bot credentials.
APP_DOMAIN=chess.example.com
WEBAPP_URL=https://chess.example.com
TG_BOT_TOKEN=REPLACE_FROM_BOTFATHER
TG_WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET
# Numeric IDs of invited ADULT Telegram testers (not usernames).
PILOT_TELEGRAM_IDS=REPLACE_WITH_ADULT_TELEGRAM_ID
FRIENDS_ENABLED=0
NODE_ENV=production
DEV_MODE=0
