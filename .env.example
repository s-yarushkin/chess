# Copy to .env locally and load via: node --env-file=.env src/server.js
PORT=8094
HOST=127.0.0.1
DB_PATH=./storage/chess.sqlite
NODE_ENV=production
TG_BOT_TOKEN=your_bot_token_from_botfather
TG_WEBHOOK_SECRET=replace_with_long_random_string
WEBAPP_URL=https://chess.example.com
# NEVER turn on in public production; local-only mock login
DEV_MODE=0
